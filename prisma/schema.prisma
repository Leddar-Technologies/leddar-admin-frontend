model Artisan {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  fullName String
  phone    String? // ✅ NEW
  whatsapp String

  specialty         ArtisanSpecialty
  yearsOfExperience Int? // ✅ NEW
  bio               String? // ✅ NEW

  city  String? // ✅ NEW
  state String? // ✅ NEW

  isActive    Boolean @default(false)
  isAvailable Boolean @default(true) // ✅ NEW (VERY useful later)

  approvedAt DateTime?
  rejectedAt DateTime?
  approvedBy String?

  portfolio  PortfolioImage[]
  jobs       Job[]
  payments   Payment[]
  bankDetail BankDetail?

  createdAt DateTime @default(now())

  @@index([userId])
}

model PortfolioImage {
  id         String  @id @default(uuid())
  artisanId  String
  fileId     String
  isApproved Boolean @default(false) // Admin quality check

  artisan Artisan @relation(fields: [artisanId], references: [id])
  file    File    @relation(fields: [fileId], references: [id])
}

//////////////////////
// ADMIN
//////////////////////

model Admin {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])
  name   String
}

//////////////////////
// KYC & AUTH
//////////////////////

model KYC {
  id       String    @id @default(uuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id])
  status   KYCStatus @default(PENDING)
  provider String // QoreID / VerifyMe
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

//////////////////////
// FILES (Cloudinary)
//////////////////////

model File {
  id       String @id @default(uuid())
  url      String
  key      String
  fileType String
  mimeType String
  size     Int?

  uploadedBy String?
  user       User?   @relation("UserUploads", fields: [uploadedBy], references: [id])

  quotes          Quote[]
  jobVideos       Job[]            @relation("JobVideo")
  jobUpdates      JobUpdate[]
  portfolioImages PortfolioImage[]

  createdAt DateTime @default(now())
}

//////////////////////
// QUOTES
//////////////////////

model Quote {
  id      String @id @default(uuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  productType String
  notes       String?
  fileId      String? // Cloudinary link to sketch/brief
  file        File?   @relation(fields: [fileId], references: [id])

  status QuoteStatus @default(SUBMITTED)
  type   QuoteType

  price     Float?
  materials Float?
  labour    Float?

  orders Order[]

  createdAt DateTime @default(now())

  @@index([brandId])
}

//////////////////////
// ORDERS
//////////////////////

model Order {
  id      String  @id @default(uuid())
  brandId String
  brand   Brand   @relation(fields: [brandId], references: [id])
  quoteId String?
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  type   OrderType
  status OrderStatus @default(SUBMITTED)

  totalAmount   Float
  flatFeePaid   Float? // For Sample flat fee tracking
  escrowBalance Float  @default(0) // Paystack escrow tracking

  jobs          Job[]
  payments      Payment[]
  invoice       Invoice?
  statusLogs    OrderStatusHistory[]
  sampleReviews SampleReview[]

  createdAt DateTime @default(now())

  @@index([brandId])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id])
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model SampleReview {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  status        String // APPROVED | REJECTED | REVISION_REQUESTED
  feedback      String?
  revisionCount Int     @default(0) // Max 2 per doc

  createdAt DateTime @default(now())
}

//////////////////////
// JOBS
//////////////////////

model Job {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  artisanId String
  artisan   Artisan @relation(fields: [artisanId], references: [id])

  type   OrderType
  status JobStatus @default(ASSIGNED)

  productType    String
  quantity       Int
  specifications String?
  deadline       DateTime?

  videoId String? // Video of finished sample
  video   File?   @relation("JobVideo", fields: [videoId], references: [id])

  updates   JobUpdate[]
  createdAt DateTime    @default(now())

  @@index([artisanId])
  @@index([orderId])
}

model JobUpdate {
  id        String   @id @default(uuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  fileId    String?
  file      File?    @relation(fields: [fileId], references: [id])
  message   String?
  createdAt DateTime @default(now())
}

//////////////////////
// PAYMENTS
//////////////////////

model Payment {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  brandId   String?
  brand     Brand?   @relation(fields: [brandId], references: [id])
  artisanId String?
  artisan   Artisan? @relation(fields: [artisanId], references: [id])

  amount    Float
  stage     PaymentStage
  status    PaymentStatus @default(PENDING)
  reference String        @unique // Paystack Reference

  createdAt DateTime @default(now())

  @@index([orderId])
}

//////////////////////
// BANK DETAILS
//////////////////////

model BankDetail {
  id        String  @id @default(uuid())
  artisanId String  @unique
  artisan   Artisan @relation(fields: [artisanId], references: [id])

  bankName      String
  accountName   String
  accountNumber String
  isVerified    Boolean @default(false)
}

//////////////////////
// INVOICES
//////////////////////

model Invoice {
  id      String @id @default(uuid())
  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id])

  pdfUrl String
  isPaid Boolean @default(false)
}

//////////////////////
// NOTIFICATIONS
//////////////////////

model Notification {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  message String
  type    NotificationType
  channel String // EMAIL | WHATSAPP

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
