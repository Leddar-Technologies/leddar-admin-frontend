generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  ADMIN
  BRAND
  ARTISAN
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
}

enum KYCStatus {
  PENDING
  VERIFIED
  FAILED
}

enum QuoteStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum QuoteType {
  SAMPLE
  PRODUCTION
}

enum OrderType {
  SAMPLE
  PRODUCTION
}

enum OrderStatus {
  SUBMITTED
  FLAT_FEE_PAID
  SAMPLE_IN_PROGRESS
  SAMPLE_COMPLETED
  SAMPLE_APPROVED
  BALANCE_PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
}

enum JobStatus {
  ASSIGNED
  IN_PROGRESS
  VIDEO_UPLOADED
  COMPLETED
  DECLINED
}

enum PaymentStage {
  SAMPLE_FLAT_FEE
  MATERIAL // Artisan Stage 1
  SERVICE // Artisan Stage 2
  FULL_PAYMENT // Brand to Escrow
}

enum PaymentStatus {
  PENDING
  HELD_IN_ESCROW
  RELEASED
  RECEIVED
  FAILED
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_UPDATE
  JOB_ASSIGNED
  SAMPLE_READY
}

enum ArtisanSpecialty {
  BAGS
  WALLETS
  BELTS
  SHOES
  JACKETS
}

//////////////////////
// USERS
//////////////////////

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String
  role          UserRole
  status        UserStatus @default(PENDING)
  emailVerified Boolean    @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  kyc     KYC?
  brand   Brand?
  artisan Artisan?
  admin   Admin?

  notifications Notification[]
  files         File[]              @relation("UserUploads")
  verifyTokens  VerificationToken[]
}

//////////////////////
// BRAND
//////////////////////

model Brand {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  businessName String
  productType  String
  whatsapp     String
  description  String?

  isActive Boolean @default(false)

  approvedAt DateTime?
  rejectedAt DateTime?
  approvedBy String? // Admin ID or name

  quotes   Quote[]
  orders   Order[]
  payments Payment[]

  createdAt DateTime @default(now())

  @@index([userId])
}

//////////////////////
// ARTISAN
//////////////////////

